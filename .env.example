# Claude (콘텐츠 생성)
ANTHROPIC_API_KEY=

# 쿠팡파트너스 오픈 API
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
COUPANG_PARTNERS_VENDOR_ID=

# 네이버 데이터랩 (검색어 트렌드) - NAVER API HUB(NCP 콘솔)에서 발급
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=

# Meta Graph API (Instagram / Facebook 페이지 발행 - 같은 Page 토큰 재사용)
META_PAGE_ACCESS_TOKEN=
META_IG_BUSINESS_ID=
META_PAGE_ID=

# Threads API (Instagram과 별도의 OAuth 플로우로 발급되는 토큰)
META_THREADS_USER_ID=
META_THREADS_ACCESS_TOKEN=

# OpenAI (이미지 생성 - gpt-image-1)
IMAGE_GEN_API_KEY=

# Cloudinary (로컬 이미지를 Instagram이 요구하는 공개 URL로 호스팅)
# https://cloudinary.com 가입 후 대시보드에서 확인
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 데이터베이스
DATABASE_URL=sqlite:///./autocpna.db

# ---------------------------------------------------------------------------
# botkit (고객사 업무 자동화 봇 - config/jobs/*.yaml)
# ---------------------------------------------------------------------------
# 텔레그램 봇 토큰: @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# 결과를 받을 채팅 ID: 개인은 @userinfobot, 그룹은 봇 초대 후 getUpdates의 chat.id
# (그룹 ID는 -100으로 시작하는 음수)
TELEGRAM_CHAT_ID=
# 실행 실패 알림을 받을 운영자 전용 채팅 ID (고객 채팅방과 반드시 분리)
OPS_TELEGRAM_CHAT_ID=

# 선택: 잡 YAML에서 참조하는 고객사별 시크릿
SLACK_WEBHOOK_URL=
CLIENT_ADMIN_TOKEN=
